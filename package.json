{
  "name": "dev-theme-pro",
  "displayName": "Dev Theme Pro",
  "description": "6-in-1 dark theme with Markdown preview, Mermaid diagrams, table tools, export workflows, and code snapshots.",
  "publisher": "FaizanAshiq",
  "version": "1.0.0",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.131.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FaizanAshiq/dev-theme-pro.git"
  },
  "bugs": {
    "url": "https://github.com/FaizanAshiq/dev-theme-pro/issues"
  },
  "homepage": "https://github.com/FaizanAshiq/dev-theme-pro#readme",
  "keywords": [
    "theme",
    "dark theme",
    "dark",
    "syntax highlighting",
    "color theme",
    "colorful",
    "dark mode",
    "night",
    "night mode",
    "editor theme",
    "vscode theme",
    "visual studio code",
    "javascript",
    "typescript",
    "react",
    "python",
    "developer",
    "programming",
    "coding",
    "smooth",
    "modern",
    "purple",
    "aesthetic",
    "eye care",
    "productivity",
    "markdown preview",
    "pdf export",
    "mermaid",
    "csv viewer",
    "code snapshot"
  ],
  "categories": [
    "Themes",
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devThemePro.openPreview",
        "title": "📄 Open Preview to the Side",
        "category": "Dev Theme Pro",
        "icon": "$(open-preview)"
      },
      {
        "command": "devThemePro.openPreviewInPlace",
        "title": "📄 Open Preview",
        "category": "Dev Theme Pro",
        "icon": "$(notebook-render-output)"
      },
      {
        "command": "devThemePro.openMarkdownWith",
        "title": "🔮 Open With Dev Theme Pro Preview",
        "category": "Dev Theme Pro",
        "icon": "$(preview)"
      },
      {
        "command": "devThemePro.openCsvPreview",
        "title": "📊 Open Table Preview to the Side",
        "category": "Dev Theme Pro",
        "icon": "$(open-preview)"
      },
      {
        "command": "devThemePro.openCsvPreviewInPlace",
        "title": "📊 Open Table Preview",
        "category": "Dev Theme Pro",
        "icon": "$(table)"
      },
      {
        "command": "devThemePro.openTableWith",
        "title": "🔮 Open With Dev Theme Pro Table Preview",
        "category": "Dev Theme Pro",
        "icon": "$(table)"
      },
      {
        "command": "devThemePro.exportPdf",
        "title": "📥 Export as PDF",
        "category": "Dev Theme Pro",
        "icon": "$(desktop-download)"
      },
      {
        "command": "devThemePro.exportHtml",
        "title": "🌐 Export as HTML",
        "category": "Dev Theme Pro",
        "icon": "$(file-code)"
      },
      {
        "command": "devThemePro.openRenderedDiff",
        "title": "🔮 Open Rendered Diff (Dev Theme Pro)",
        "category": "Dev Theme Pro",
        "icon": "$(diff)"
      },
      {
        "command": "devThemePro.codeSnapshot",
        "title": "📸 Code Snapshot",
        "category": "Dev Theme Pro",
        "icon": "$(device-camera)"
      },
      {
        "command": "devThemePro.exportDiagram",
        "title": "📊 Export Diagram",
        "category": "Dev Theme Pro",
        "icon": "$(graph)"
      },
      {
        "command": "devThemePro.exportCsvPng",
        "title": "📸 Export Table as PNG",
        "category": "Dev Theme Pro",
        "icon": "$(device-camera)"
      },
      {
        "command": "devThemePro.exportCsvHtml",
        "title": "🌐 Export Table as HTML",
        "category": "Dev Theme Pro",
        "icon": "$(file-code)"
      }
    ],
    "submenus": [
      {
        "id": "devThemePro.tools",
        "label": "🔮 Dev Theme Pro",
        "icon": "$(tools)"
      }
    ],
    "keybindings": [
      {
        "command": "devThemePro.openPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == markdown"
      },
      {
        "command": "devThemePro.openPreviewInPlace",
        "key": "ctrl+k ctrl+v",
        "mac": "cmd+k cmd+v",
        "when": "editorLangId == markdown"
      },
      {
        "command": "devThemePro.openCsvPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "resourceExtname =~ /^\\.(csv|tsv|psv|dsv|ssv|tab)$/"
      },
      {
        "command": "devThemePro.openCsvPreviewInPlace",
        "key": "ctrl+k ctrl+v",
        "mac": "cmd+k cmd+v",
        "when": "resourceExtname =~ /^\\.(csv|tsv|psv|dsv|ssv|tab)$/"
      },
      {
        "command": "devThemePro.codeSnapshot",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "devThemePro.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "devThemePro.openCsvPreview",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv|dsv|ssv|tab)$/",
          "group": "navigation@1"
        },
        {
          "command": "devThemePro.codeSnapshot",
          "when": "resourceScheme == file || resourceScheme == untitled",
          "group": "navigation@3"
        },
        {
          "command": "devThemePro.exportPdf",
          "when": "activeWebviewPanelId == devThemeProPreview",
          "group": "navigation"
        },
        {
          "command": "devThemePro.exportHtml",
          "when": "activeWebviewPanelId == devThemeProPreview",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "submenu": "devThemePro.tools",
          "group": "1_devThemePro"
        }
      ],
      "explorer/context": [
        {
          "command": "devThemePro.openMarkdownWith",
          "when": "resourceExtname == .md",
          "group": "navigation@2"
        },
        {
          "command": "devThemePro.openTableWith",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv|dsv|ssv|tab)$/",
          "group": "navigation@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "devThemePro.openMarkdownWith",
          "when": "resourceExtname == .md",
          "group": "navigation@2"
        },
        {
          "command": "devThemePro.openTableWith",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv|dsv|ssv|tab)$/",
          "group": "navigation@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "devThemePro.openRenderedDiff",
          "when": "scmProvider == git",
          "group": "navigation@2"
        }
      ],
      "devThemePro.tools": [
        {
          "command": "devThemePro.openPreview",
          "when": "editorLangId == markdown",
          "group": "1_preview@1"
        },
        {
          "command": "devThemePro.openPreviewInPlace",
          "when": "editorLangId == markdown",
          "group": "1_preview@2"
        },
        {
          "command": "devThemePro.openCsvPreview",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv|dsv|ssv|tab)$/",
          "group": "1_preview@1"
        },
        {
          "command": "devThemePro.openCsvPreviewInPlace",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv|dsv|ssv|tab)$/",
          "group": "1_preview@2"
        },
        {
          "command": "devThemePro.codeSnapshot",
          "when": "editorTextFocus",
          "group": "3_code@1"
        }
      ],
      "commandPalette": [
        {
          "command": "devThemePro.openPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "devThemePro.openPreviewInPlace",
          "when": "editorLangId == markdown"
        },
        {
          "command": "devThemePro.openMarkdownWith",
          "when": "editorLangId == markdown"
        },
        {
          "command": "devThemePro.exportPdf",
          "when": "editorLangId == markdown"
        },
        {
          "command": "devThemePro.exportHtml",
          "when": "editorLangId == markdown"
        },
        {
          "command": "devThemePro.openRenderedDiff",
          "when": "editorLangId == markdown"
        },
        {
          "command": "devThemePro.exportDiagram",
          "when": "editorLangId == markdown"
        },
        {
          "command": "devThemePro.openCsvPreview",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv|dsv|ssv|tab)$/"
        },
        {
          "command": "devThemePro.openCsvPreviewInPlace",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv|dsv|ssv|tab)$/"
        },
        {
          "command": "devThemePro.openTableWith",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv|dsv|ssv|tab)$/"
        },
        {
          "command": "devThemePro.exportCsvPng",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv|dsv|ssv|tab)$/"
        },
        {
          "command": "devThemePro.exportCsvHtml",
          "when": "resourceExtname =~ /^\\.(csv|tsv|psv|dsv|ssv|tab)$/"
        },
        {
          "command": "devThemePro.codeSnapshot"
        }
      ]
    },
    "configuration": {
      "title": "Dev Theme Pro",
      "properties": {
        "devThemePro.chromePath": {
          "type": "string",
          "default": "",
          "description": "Path to Chrome or Chromium executable for PDF export. Leave empty for auto-detection."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "devThemePro.markdownPreview",
        "displayName": "🔮 Dev Theme Pro Markdown Preview",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "devThemePro.csvPreview",
        "displayName": "🔮 Dev Theme Pro Table Preview",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.psv"
          },
          {
            "filenamePattern": "*.dsv"
          },
          {
            "filenamePattern": "*.ssv"
          },
          {
            "filenamePattern": "*.tab"
          }
        ],
        "priority": "option"
      }
    ],
    "themes": [
      {
        "id": "Dev Theme Pro — Ocean Mist",
        "label": "Dev Theme Pro: Ocean Mist",
        "uiTheme": "vs-dark",
        "path": "./themes/dev-theme-pro-ocean-mist-color-theme.json"
      },
      {
        "id": "Dev Theme Pro — Nebula Mist",
        "label": "Dev Theme Pro: Nebula Mist",
        "uiTheme": "vs-dark",
        "path": "./themes/dev-theme-pro-nebula-mist-color-theme.json"
      },
      {
        "id": "Dev Theme Pro — Solar Mist",
        "label": "Dev Theme Pro: Solar Mist",
        "uiTheme": "vs-dark",
        "path": "./themes/dev-theme-pro-solar-mist-color-theme.json"
      },
      {
        "id": "Dev Theme Pro — Ocean Void",
        "label": "Dev Theme Pro: Ocean Void",
        "uiTheme": "vs-dark",
        "path": "./themes/dev-theme-pro-ocean-void-color-theme.json"
      },
      {
        "id": "Dev Theme Pro — Nebula Void",
        "label": "Dev Theme Pro: Nebula Void",
        "uiTheme": "vs-dark",
        "path": "./themes/dev-theme-pro-nebula-void-color-theme.json"
      },
      {
        "id": "Dev Theme Pro — Solar Void",
        "label": "Dev Theme Pro: Solar Void",
        "uiTheme": "vs-dark",
        "path": "./themes/dev-theme-pro-solar-void-color-theme.json"
      }
    ]
  },
  "scripts": {
    "generate": "node src/generate.js && node src/audit-theme.js",
    "audit": "node src/audit-theme.js",
    "build:webviews": "node src/build-webview-assets.js",
    "build:css": "node src/build-preview-css.js",
    "compile": "node esbuild.js",
    "watch": "npm run build:webviews && npm run build:css && node esbuild.js --watch",
    "build": "npm run build:webviews && npm run build:css && npm run compile",
    "vscode:prepublish": "node -e \"const fs=require('fs'); const required=['out/extension.js','out/markdown-worker.js','media/preview.css','media/webviews/markdown/preview.html','media/webviews/markdown/loading-shell.html','media/webviews/markdown/loading-shell.css','media/webviews/csv/preview.html','media/webviews/shared/panel-widget.html','media/webviews/shared/loading-overlay.js']; const missing=required.filter(file=>!fs.existsSync(file)); if(missing.length){console.error('Missing built outputs:', missing.join(', ')); process.exit(1);} console.log('Built outputs verified');\"",
    "pack": "npm run generate && npm run build:webviews && npm run build:css && node esbuild.js --production && npx @vscode/vsce package"
  },
  "dependencies": {
    "@vscode/vsce": "^3.9.2",
    "diff": "^9.0.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.16.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.125.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "less": "^4.8.1",
    "typescript": "^7.0.2"
  }
}
